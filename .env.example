# ==============================================================================
# RecoverAI — Environment Variables Configuration
# Copy this file to server/.env before starting the server.
# NEVER commit .env to version control.
# ==============================================================================

# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database Configuration
# Provide a MongoDB URI (e.g., mongodb://localhost:27017/recoverai or MongoDB Atlas).
# If left empty, RecoverAI will automatically spin up an embedded mongodb-memory-server for zero-setup demo/testing!
MONGODB_URI=mongodb://localhost:27017/recoverai

# Authentication & Security
JWT_SECRET=recoverai_super_secret_jwt_key_change_in_production_min32chars!
JWT_EXPIRES_IN=7d
COOKIE_SECRET=recoverai_cookie_signing_secret_key_32chars_minimum!

# Razorpay Test Mode Credentials
# Get your test keys from Razorpay Dashboard -> Settings -> API Keys
RAZORPAY_KEY_ID=rzp_test_yourKeyIdHere
RAZORPAY_KEY_SECRET=yourKeySecretHere
RAZORPAY_WEBHOOK_SECRET=yourWebhookSecretHere

# AI Provider Configuration
# Supported providers: Gemini API, OpenAI API, or local rule-based fallback.
# If AI_API_KEY is omitted, RecoverAI operates gracefully in Fallback Deterministic Mode with zero crashes!
AI_PROVIDER=gemini
AI_API_KEY=your_gemini_or_openai_api_key_here
AI_MODEL=gemini-1.5-flash

# Policy & Action Thresholds (Amounts in Paise: 1 INR = 100 Paise)
# Transactions exceeding this amount require human-in-the-loop approval (Default: 500000 paise = ₹5,000)
AUTO_ACTION_MAX_AMOUNT_PAISE=500000
MAX_RECOVERY_ATTEMPTS=3
COOLDOWN_PERIOD_MINUTES=15
MIN_CONFIDENCE_AUTO_ACTION=0.75
